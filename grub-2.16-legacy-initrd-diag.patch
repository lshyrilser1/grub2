diff --git a/grub-core/loader/efi/linux.c b/grub-core/loader/efi/linux.c
index 86fd175..a5314a0 100644
--- a/grub-core/loader/efi/linux.c
+++ b/grub-core/loader/efi/linux.c
@@ -404,7 +404,12 @@ grub_cmd_initrd (grub_command_t cmd __attribute__ ((unused)),
 
 #if defined(__i386__) || defined(__x86_64__)
   if (!initrd_use_loadfile2)
-    return grub_cmd_initrd_x86_legacy (cmd, argc, argv);
+    {
+      grub_dprintf ("linux",
+                    "kernel advertises no LoadFile2 initrd support, "
+                    "falling back to the legacy one-shot initrd loader\n");
+      return grub_cmd_initrd_x86_legacy (cmd, argc, argv);
+    }
 #endif
 
   if (!loaded)
diff --git a/grub-core/loader/i386/linux.c b/grub-core/loader/i386/linux.c
index 35b3142..2796e5b 100644
--- a/grub-core/loader/i386/linux.c
+++ b/grub-core/loader/i386/linux.c
@@ -1124,6 +1124,15 @@ grub_cmd_initrd (grub_command_t cmd __attribute__ ((unused)),
   /* Put the initrd as high as possible, 4KiB aligned.  */
   addr = (addr_max - aligned_size) & ~0xFFF;
 
+#ifdef GRUB_MACHINE_EFI
+  grub_dprintf ("linux",
+                "legacy initrd: need 0x%" PRIxGRUB_SIZE
+                " contiguous bytes below 0x%" PRIxGRUB_ADDR
+                " (initrd_addr_max); low RAM may be reported as "
+                "boot-services memory on this firmware\n",
+                aligned_size, addr_max);
+#endif
+
   grub_dprintf ("linux",
                 "Initrd at addr 0x%" PRIxGRUB_ADDR " which is expected in"
                 " ranger 0x%" PRIxGRUB_ADDR " ~ 0x%" PRIxGRUB_ADDR "\n",
@@ -1143,7 +1152,19 @@ grub_cmd_initrd (grub_command_t cmd __attribute__ ((unused)),
 					    GRUB_RELOCATOR_PREFERENCE_HIGH,
 					    1);
     if (err)
-      goto fail;
+      {
+#ifdef GRUB_MACHINE_EFI
+	grub_error (GRUB_ERR_OUT_OF_MEMORY,
+		    "no contiguous conventional memory below "
+		    "initrd_addr_max (0x%" PRIxGRUB_ADDR ") to hold the "
+		    "0x%" PRIxGRUB_SIZE " byte initrd; this firmware reports "
+		    "low RAM as EFI boot-services memory while GRUB runs. "
+		    "Use a kernel with LoadFile2 support (PE header "
+		    "major_image_version >= 1) or a smaller initrd",
+		    addr_max, aligned_size);
+#endif
+	goto fail;
+      }
     initrd_mem = get_virtual_current_address (ch);
     initrd_mem_target = get_physical_target_address (ch);
   }
